# Copy this file to .env and fill in your keys.
# Example (PowerShell): Copy-Item .env.example .env

# Active provider used by the Tray and new workflows.
CLIPAI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite

# Olama / Ollama-compatible local server
OLAMA_BASE_URL=http://localhost:11434
OLAMA_MODEL=gemma3:1b

# Azure OpenAI (reserved for provider scaffold)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=

# OpenAI-compatible compact provider (reserved for provider scaffold)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Single OpenAI-compatible gateway (API key is optional)
CLIPAI_GATEWAY_NAME=Custom Gateway
CLIPAI_GATEWAY_BASE_URL=
CLIPAI_GATEWAY_API_KEY=
CLIPAI_GATEWAY_MODEL=
